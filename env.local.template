# ─────────────────────────────────────────
# DATABASE
# ─────────────────────────────────────────
# Pakai Supabase (gratis): https://supabase.com
# Setelah buat project, copy connection string dari Settings > Database
DATABASE_URL="postgresql://postgres:[PASSWORD]@db.[PROJECT].supabase.co:5432/postgres"

# ─────────────────────────────────────────
# NEXTAUTH
# ─────────────────────────────────────────
# Generate secret: jalankan perintah ini di terminal:
# openssl rand -base64 32
NEXTAUTH_SECRET="isi-dengan-random-string-panjang"
NEXTAUTH_URL="http://localhost:3000"

# Google OAuth (opsional untuk login dengan Google)
# Buat di: https://console.cloud.google.com
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# ─────────────────────────────────────────
# AI MODELS
# ─────────────────────────────────────────
# Anthropic (Claude) — https://console.anthropic.com
ANTHROPIC_API_KEY="sk-ant-..."

# OpenAI — https://platform.openai.com/api-keys
# Wajib kalau ada AiModel dengan provider=OPENAI di DB.
OPENAI_API_KEY="sk-..."

# Google Gemini — https://aistudio.google.com/apikey
# Wajib kalau ada AiModel dengan provider=GOOGLE di DB. Free tier tersedia.
GOOGLE_AI_API_KEY=""

# ─────────────────────────────────────────
# PAYMENT — TRIPAY
# ─────────────────────────────────────────
# Buat akun di: https://tripay.co.id
# Gunakan Sandbox dulu untuk testing — endpoint: https://tripay.co.id/api-sandbox/
# Set TRIPAY_IS_PRODUCTION=true setelah verifikasi merchant production.
TRIPAY_API_KEY=""
TRIPAY_PRIVATE_KEY=""
TRIPAY_MERCHANT_CODE=""
TRIPAY_IS_PRODUCTION="false"
# Method default saat create transaksi (mis. QRIS, BRIVA, BCAVA, OVO).
# Bisa di-override per request dari frontend kalau perlu.
TRIPAY_DEFAULT_METHOD="QRIS"

# ─────────────────────────────────────────
# WA SERVICE
# ─────────────────────────────────────────
# URL service WA yang jalan di port 3001
WA_SERVICE_URL="http://localhost:3001"
WA_SERVICE_SECRET="secret-untuk-komunikasi-internal"
NEXT_PUBLIC_WA_SERVICE_URL="http://localhost:3001"
NEXT_PUBLIC_SOCKET_URL="http://localhost:3001"

# ─────────────────────────────────────────
# CRON (auth endpoint /api/cron/*)
# ─────────────────────────────────────────
# Wajib diisi — endpoint /api/cron/* fail-closed (menolak request) kalau kosong.
# Generate: openssl rand -hex 16
CRON_SECRET=""

# ─────────────────────────────────────────
# APP CONFIG
# ─────────────────────────────────────────
NEXT_PUBLIC_APP_NAME="WA CS Platform"
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Admin pertama (email yang otomatis jadi admin saat register)
ADMIN_EMAIL="arli@email.com"

# ─────────────────────────────────────────
# EMAIL (untuk reset password, notifikasi)
# ─────────────────────────────────────────
# Untuk dev pakai Mailtrap (gratis): https://mailtrap.io
# Buat inbox, copy SMTP credentials di tab "Show Credentials"
EMAIL_HOST="sandbox.smtp.mailtrap.io"
EMAIL_PORT="2525"
EMAIL_USER=""
EMAIL_PASS=""
EMAIL_FROM="WA CS Platform <no-reply@wa-cs.local>"

# ─────────────────────────────────────────
# E-BOOK (storage privat file PDF/EPUB berbayar)
# ─────────────────────────────────────────
# Default kalau kosong: <project>/storage/ebooks. WAJIB di luar public/
# (public/uploads diserve tanpa auth di produksi).
EBOOK_STORAGE_DIR="./storage/ebooks"

# ─────────────────────────────────────────
# ENKRIPSI (WAJIB untuk API key AI di /admin/api-keys & token WABA)
# ─────────────────────────────────────────
# 64 karakter hex (32 byte). Generate: openssl rand -hex 32
# AWAS: mengganti nilai ini membuat semua data terenkripsi lama tak terbaca.
ENCRYPTION_KEY=""

# ─────────────────────────────────────────
# META — WhatsApp Cloud API (Embedded Signup, webhook, kirim pesan)
# ─────────────────────────────────────────
# Dari Meta Developer Dashboard (app Tech Provider):
META_APP_ID=""
META_APP_SECRET=""
# Token verifikasi webhook — bebas tentukan sendiri, paste nilai yang sama di
# Meta dashboard saat konfigurasi webhook (Callback URL: /api/webhooks/meta).
META_VERIFY_TOKEN=""
# Configuration ID Embedded Signup (Facebook Login for Business).
META_CONFIG_ID=""
# Versi Graph API (opsional, default v23.0).
# META_GRAPH_VERSION="v23.0"
# Embedded Signup memakai Facebook JS SDK di browser. Di Meta App dashboard:
# Facebook Login for Business → Settings → "Login with the JavaScript SDK" = Yes,
# dan "Allowed Domains for the JavaScript SDK" memuat domain hulao
# (https://hulao.id, https://develop.hulao.id, http://localhost:3000 utk dev).
# PIN two-step nomor (jalur standar) kini per-nomor: diisi user atau dibuat
# otomatis, disimpan terenkripsi di WhatsappSession — bukan env global.

